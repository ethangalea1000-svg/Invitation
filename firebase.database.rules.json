{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invitations": {
      "$inviteId": {
        ".read": "auth != null && data.child('ownerUid').val() === auth.uid",
        ".write": "auth != null && (!data.exists() ? newData.child('ownerUid').val() === auth.uid : data.child('ownerUid').val() === auth.uid)",
        "responses": {
          "$responseId": {
            ".read": "auth != null && root.child('invitations').child($inviteId).child('ownerUid').val() === auth.uid",
            ".write": "newData.child('createdAt').isNumber() && newData.child('answer').isString() && newData.child('answer').val().matches(/^(yes|no)$/) && newData.child('name').isString() && newData.child('name').val().length <= 60"
          }
        }
      }
    }
  }
}